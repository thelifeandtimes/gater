[Unit]
Description=Gater Nockmilio finalized ownership index
Requires=gater-comet.service
After=gater-comet.service
PartOf=gater-comet.service
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=simple
WorkingDirectory=%h/repos/gater
Environment=PATH=%h/.local/bin:/usr/local/bin:/usr/bin
ExecStart=/bin/bash %h/repos/gater/scripts/watch-comet.sh
Restart=on-failure
RestartSec=30
TimeoutStopSec=30
UMask=0077

[Install]
WantedBy=default.target
